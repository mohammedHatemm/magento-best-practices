<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <!-- Main Product Labels Table -->
    <table name="elsherif_product_label"
           resource="default"
           engine="innodb"
           comment="Elsherif Product Labels Table">

        <!-- Primary Key -->
        <column xsi:type="int"
                name="label_id"
                unsigned="true"
                nullable="false"
                identity="true"
                comment="Label ID"/>

        <!-- Basic Information -->
        <column xsi:type="varchar"
                name="name"
                length="255"
                nullable="false"
                comment="Label Name (Admin Reference)"/>

        <column xsi:type="varchar"
                name="label_text"
                length="255"
                nullable="true"
                comment="Label Text to Display"/>

        <column xsi:type="varchar"
                name="label_type"
                length="50"
                nullable="false"
                default="text"
                comment="Label Type: text or image"/>

        <column xsi:type="varchar"
                name="image"
                length="255"
                nullable="true"
                comment="Label Image Path"/>

        <!-- Styling -->
        <column xsi:type="varchar"
                name="text_color"
                length="7"
                nullable="false"
                default="#FFFFFF"
                comment="Text Color (Hex)"/>

        <column xsi:type="varchar"
                name="background_color"
                length="7"
                nullable="false"
                default="#FF0000"
                comment="Background Color (Hex)"/>

        <column xsi:type="varchar"
                name="position"
                length="50"
                nullable="false"
                default="top-left"
                comment="Label Position on Product Image"/>

        <column xsi:type="varchar"
                name="css_class"
                length="255"
                nullable="true"
                comment="Additional CSS Classes"/>

        <!-- Conditions -->
        <column xsi:type="text"
                name="conditions_serialized"
                nullable="true"
                comment="Serialized Conditions (JSON)"/>

        <!-- Product Scope -->
        <column xsi:type="text"
                name="product_ids"
                nullable="true"
                comment="Specific Product IDs (comma-separated)"/>

        <column xsi:type="text"
                name="category_ids"
                nullable="true"
                comment="Category IDs (comma-separated)"/>

        <!-- Settings -->
        <column xsi:type="int"
                name="priority"
                unsigned="true"
                nullable="false"
                default="0"
                comment="Display Priority (0 = Highest)"/>

        <column xsi:type="smallint"
                name="is_active"
                unsigned="true"
                nullable="false"
                default="1"
                comment="Is Label Active"/>

        <!-- Date Range -->
        <column xsi:type="date"
                name="from_date"
                nullable="true"
                comment="Active From Date"/>

        <column xsi:type="date"
                name="to_date"
                nullable="true"
                comment="Active To Date"/>

        <!-- Store Scope -->
        <column xsi:type="varchar"
                name="store_ids"
                length="255"
                nullable="false"
                default="0"
                comment="Store IDs (comma-separated, 0 = All Stores)"/>

        <!-- Timestamps -->
        <column xsi:type="timestamp"
                name="created_at"
                nullable="false"
                default="CURRENT_TIMESTAMP"
                comment="Created At"/>

        <column xsi:type="timestamp"
                name="updated_at"
                nullable="false"
                default="CURRENT_TIMESTAMP"
                on_update="true"
                comment="Updated At"/>

        <!-- Constraints -->
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="label_id"/>
        </constraint>

        <!-- Indexes for better performance -->
        <index referenceId="ELSHERIF_PRODUCT_LABEL_IS_ACTIVE" indexType="btree">
            <column name="is_active"/>
        </index>

        <index referenceId="ELSHERIF_PRODUCT_LABEL_PRIORITY" indexType="btree">
            <column name="priority"/>
        </index>

        <index referenceId="ELSHERIF_PRODUCT_LABEL_FROM_DATE" indexType="btree">
            <column name="from_date"/>
        </index>

        <index referenceId="ELSHERIF_PRODUCT_LABEL_TO_DATE" indexType="btree">
            <column name="to_date"/>
        </index>

    </table>

</schema>
