<?php
/**
 * Display loyalty points on product page
 * @var \Elsherif\LoyaltySystem\Block\Product\Points $block
 */

if (!$block->shouldShow()) {
    return;
}

$points = $block->getProductPoints();
$pointsWorth = $block->getPointsWorth();
?>

<div class="loyalty-points-badge" data-role="loyalty-points">
    <div class="loyalty-points-inner">
        <span class="loyalty-icon">🏆</span>
        <span class="loyalty-text">
            <?= $block->escapeHtml(__('Earn')) ?>
            <strong class="points-value"><?= $block->escapeHtml($points) ?></strong>
            <?= $block->escapeHtml(__('Points')) ?>
        </span>
        <?php if ($pointsWorth > 0): ?>
            <span class="loyalty-worth">
                (<?= $block->escapeHtml(__('Worth')) ?> 
                <?= /* @noEscape */ $block->getLayout()->getBlock('product.price.render.default')
                    ? $this->helper(\Magento\Framework\Pricing\Helper\Data::class)->currency($pointsWorth, true, false)
                    : '$' . number_format($pointsWorth, 2) ?>)
            </span>
        <?php endif; ?>
    </div>
</div>

<style>
.loyalty-points-badge {
    margin: 15px 0;
    padding: 12px 16px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 8px;
    display: inline-block;
}

.loyalty-points-inner {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #fff;
    font-size: 14px;
}

.loyalty-points-badge .loyalty-icon {
    font-size: 20px;
}

.loyalty-points-badge .points-value {
    font-size: 18px;
    font-weight: 700;
}

.loyalty-points-badge .loyalty-worth {
    font-size: 12px;
    opacity: 0.9;
}

/* Dark mode support */
@media (prefers-color-scheme: dark) {
    .loyalty-points-badge {
        background: linear-gradient(135deg, #5a67d8 0%, #6b46c1 100%);
    }
}
</style>
