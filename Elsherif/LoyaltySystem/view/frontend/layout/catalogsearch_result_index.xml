<?xml version="1.0"?>
<!--
/**
 * Search results - Add loyalty points to product listing
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Elsherif\LoyaltySystem\Block\Product\ListingPoints"
                   name="loyalty.listing.points.search"
                   template="Elsherif_LoyaltySystem::product/listing/points.phtml"
                   after="-"/>
        </referenceContainer>
    </body>
</page>
