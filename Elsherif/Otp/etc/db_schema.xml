<?xml version="1.0"  ?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="elsherif_otp"
           resource="default"
           engine="innodb"
           comment="Otp table">
        <column xsi:type="int"
                name="otp_id"
                unsigned="true"
                nullable="false"
                identity="true" comment="otp id"
        />
        <column xsi:type="varchar"
                name="identifier"
                nullable="false"
                length="255"
                comment="email or phone"
        />
        <column xsi:type="varchar"
                name="otp_code"
                nullable="false"
                length="255"
                comment="hash otp code"
        />
        <column xsi:type="varchar"
                name="purpose"
                length="50"
                nullable="false"
                default="login"
                comment="Purpose"
        />
        <column xsi:type="varchar"
                name="send_method"
                nullable="false"
                length="20"
                default="email"
                comment="send Method"
        />
        <column xsi:type="varchar" name="status" nullable="false"
                length="20" default="pending" comment="Status"/>
        <column xsi:type="smallint" name="attempts" unsigned="true"
                nullable="false" default="0" comment="Failed Attempts"/>

        <column xsi:type="timestamp" name="created_at" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="expires_at" nullable="false"
                comment="Expires At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY" >
            <column name="otp_id" />
        </constraint>

        <index referenceId="ELSHRIF_OTP_IDENTIFIER" indexType="btree">
            <column name="identifier"/>
        </index>


    </table>
</schema>
